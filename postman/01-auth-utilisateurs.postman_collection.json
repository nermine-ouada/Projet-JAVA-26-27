{
  "info": {
    "name": "01 Auth et Utilisateurs",
    "description": "Authentification (login, inscription, me, logout) et CRUD des utilisateurs. Lancer les dossiers dans l'ordre (Runner) : chaque requete enregistre les tokens et les id utilises par les suivantes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Connexion",
      "item": [
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Token recu et role ADMIN\", function () { pm.expect(json.token).to.be.a(\"string\"); pm.expect(json.utilisateur.role).to.eql(\"ADMIN\"); });",
                  "pm.collectionVariables.set(\"adminToken\", json.token);",
                  "pm.collectionVariables.set(\"adminId\", json.utilisateur.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fitness.tn\",\n  \"motDePasse\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
