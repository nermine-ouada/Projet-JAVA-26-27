                  "pm.test(\"Role COACH avec specialite et telephone\", function () { pm.expect(json.role).to.eql(\"COACH\"); pm.expect(json.specialite).to.eql(\"Boxe\"); pm.expect(json.telephone).to.eql(\"22 000 000\"); });",
